DATABASE_URL="postgresql://omnios:omnios@localhost:5433/omnios"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
# 30d (not 7d) so a laptop that sleeps over a weekend doesn't force a
# re-login on wake -- see AuthService.issueRefreshToken.
JWT_REFRESH_TTL="30d"
PORT=4001
CORS_ORIGIN="http://localhost:8080"
# Secret for verifying inbound GitHub webhook signatures (set the same value on the GitHub webhook).
GITHUB_WEBHOOK_SECRET="change-me-webhook"
# 32-byte hex key used to encrypt secrets at rest (e.g. the stored GitHub token).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="change-me-64-hex-chars"
# Frontend base URL for password-reset links (defaults to CORS_ORIGIN).
APP_URL="http://localhost:8080"
# Transactional email for password resets. Set ONE; if neither is set, reset
# links are only logged to the server console (dev mode).
RESEND_API_KEY=""
SENDGRID_API_KEY=""
# Verified sender for your provider, e.g. "Venus CRM <noreply@yourdomain.com>".
MAIL_FROM="Venus CRM <onboarding@resend.dev>"

# OAuth mailbox connect (Gmail/Outlook) -- see modules/email-oauth. Leaving
# these unset is fine: the app boots and everything else works normally,
# "Connect with Google/Outlook" just reports itself as unavailable until
# both of a provider's pair are set (checked at request time, not boot).
# Backend base URL Google/Microsoft redirect back to after consent --
# NOT the frontend URL (that's APP_URL above). Must exactly match one of
# the redirect URIs registered on the OAuth app.
OAUTH_REDIRECT_BASE_URL="http://localhost:4001"
# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID,
# type "Web application", redirect URI: {OAUTH_REDIRECT_BASE_URL}/email-oauth/google/callback).
# The gmail.readonly scope this app requests is a Google "restricted" scope --
# beyond a 100-user Testing cap, going to production requires Google's
# verification process (a CASA security assessment for restricted scopes).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# From Microsoft Entra admin center > App registrations (redirect URI:
# {OAUTH_REDIRECT_BASE_URL}/email-oauth/microsoft/callback). Use "common" for
# a multi-tenant app, or a specific tenant/directory ID to restrict to one
# organization.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
