DATABASE_URL="postgresql://omnios:omnios@localhost:5433/omnios"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
# 30d (not 7d) so a laptop that sleeps over a weekend doesn't force a
# re-login on wake -- see AuthService.issueRefreshToken.
JWT_REFRESH_TTL="30d"
PORT=4001
CORS_ORIGIN="http://localhost:8080"
# Secret for verifying inbound GitHub webhook signatures (set the same value on the GitHub webhook).
GITHUB_WEBHOOK_SECRET="change-me-webhook"
# 32-byte hex key used to encrypt secrets at rest (e.g. the stored GitHub token).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="change-me-64-hex-chars"
# Frontend base URL for password-reset links (defaults to CORS_ORIGIN).
APP_URL="http://localhost:8080"
# Transactional email for password resets. Set ONE; if neither is set, reset
# links are only logged to the server console (dev mode).
RESEND_API_KEY=""
SENDGRID_API_KEY=""
# Verified sender for your provider, e.g. "Venus CRM <noreply@yourdomain.com>".
MAIL_FROM="Venus CRM <onboarding@resend.dev>"
